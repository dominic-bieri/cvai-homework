TAPO_USER=deinUsername
TAPO_PASS=deinPasswort
TAPO_HOST=192.168.1.50
TAPO_PORT=554

# Label Studio (active learning pipeline)
# Get the refresh token from Label Studio → Account & Settings → Access Token
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_PROJECT_ID=1
LABEL_STUDIO_REFRESH_TOKEN=your_label_studio_refresh_token

TS_AUTHKEY=tskey-auth-xxxxx   # von Tailscale Admin Panel → Settings → Auth Keys

# Counter
INTERVAL_SECONDS=60

# Dashboard
SWARM_THRESHOLD=100
ALARM_COOLDOWN_MINUTES=5
ALARM_RETENTION_DAYS=30    